# JalDrishti optional API keys. Copy to backend/.env and fill in any you have.
# Every key is optional: with none set the dashboard runs on keyless public data
# (Open-Meteo, GloFAS, Copernicus DEM, OpenStreetMap) and the AI features use
# deterministic, data-grounded fallbacks.

# --- LLM for the Copilot chat and advisory generator (any one is enough) ---
# Google Gemini - FREE tier, no card: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Groq (Llama) - FREE tier, no card: https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Anthropic Claude - paid, best answer quality: https://console.anthropic.com/
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5

# Which to prefer when several are set: auto | anthropic | gemini | groq
# JALDRISHTI_LLM_PROVIDER=auto

# --- Second rainfall forecast for multi-model consensus ---
# OpenWeatherMap - FREE, 1,000 calls/day, no card: https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=

# --- CWC relay (only for servers outside India, e.g. Render Singapore) ---
# The CWC portal does not answer foreign IPs. Point this at the relay function
# deployed with the frontend on Vercel (Mumbai) and use the same random token
# there as CWC_RELAY_TOKEN. Leave empty when running in India.
JALDRISHTI_CWC_RELAY=
JALDRISHTI_CWC_RELAY_TOKEN=

# --- Sign-in ---
# Password for the seeded central / state / district accounts (set before first boot).
# JALDRISHTI_SEED_PASSWORD=jaldrishti@2026
# One-click demo sign-in by role, without a password (1 = on).
# JALDRISHTI_DEMO_LOGIN=1
# Token signing key; generated and stored in the database if unset.
# JALDRISHTI_SECRET=

# --- Notifications (email / WhatsApp / SMS / calls via viaSocket) ---
# Webhook URL of a viaSocket flow with a Webhook trigger. JalDrishti posts one
# JSON event per message to it. See docs/NOTIFICATIONS.md.
# JALDRISHTI_NOTIFY_WEBHOOK=
# Shared secret viaSocket must send as header X-JalDrishti-Secret when it
# calls /api/hooks/inbound (WhatsApp question bot). Any long random string.
# JALDRISHTI_NOTIFY_SECRET=
# Hour (IST) the daily brief goes out.
# JALDRISHTI_DAILY_BRIEF_HOUR=8
# Public dashboard URL, used for links inside messages.
# JALDRISHTI_PUBLIC_WEB_URL=

# --- Deployment (set these on Render; leave unset locally) ---
# Password for the seeded central/state/district admin accounts (first boot only).
# JALDRISHTI_SEED_PASSWORD=
# 0 turns off one-click demo sign-in.
# JALDRISHTI_DEMO_LOGIN=1
# Dashboard URL used in alert links, e.g. https://jaldrishti.vercel.app
# JALDRISHTI_PUBLIC_WEB_URL=
# Alert recipients restored at every boot (hosts without a persistent disk), JSON:
# JALDRISHTI_NOTIFY_RECIPIENTS=[{"username":"central","email":"you@example.org","channels":["email"]}]
# Keep-alive target; on Render it defaults to RENDER_EXTERNAL_URL. Empty = off.
# JALDRISHTI_KEEPALIVE_URL=
